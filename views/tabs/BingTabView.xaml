<UserControl x:Class="XboxMetroLauncher.Views.Tabs.BingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:XboxMetroLauncher.Views.Tabs;assembly=DashX360"
             xmlns:bing="clr-namespace:XboxMetroLauncher.Models.Bing;assembly=DashX360">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- ===== LANDING TILE (original layout, untouched coordinates) ===== -->
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Visibility="{Binding IsResultsOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
      <Canvas Name="HomeAlignedFrame" Left="198" Top="11" Width="764" Height="368" ClipToBounds="False">
        <Canvas Name="ContentTileLayer" Left="0" Top="0" Width="764" Height="368">

          <TextBlock Text="Search Xbox for games, movies, music and apps"
                     Canvas.Left="180" Canvas.Top="93"
                     Foreground="#BFFFFFFF" FontSize="19" FontWeight="Light" />

          <!-- bing wordmark: orange b + white ing -->
          <Canvas Canvas.Left="0" Canvas.Top="137" Width="200" Height="52">
            <Path Fill="#FFB900" Data="M6,2 L6,46 L16,46 L16,32 Q26,38 32,32 Q40,24 32,16 Q26,10 16,16 L16,2 Z"/>
            <TextBlock Text="ing" Canvas.Left="34" Canvas.Top="0"
                       Foreground="#F2FFFFFF" FontSize="44" FontWeight="Light" />
          </Canvas>

          <Border Name="SearchBoxFrame" Canvas.Left="179" Canvas.Top="123"
                  Width="585" Height="92" BorderBrush="#C9FFFFFF" BorderThickness="2"
                  Background="#C8000000" MouseLeftButtonDown="SearchBoxFrame_OnMouseLeftButtonDown">
            <Grid>
              <TextBox Name="BingSearchBox" Background="#00FFFFFF" BorderThickness="0"
                       Foreground="#F2FFFFFF" CaretBrush="#FFFFFFFF"
                       FontSize="40" FontWeight="Light" Padding="28,18,84,0"
                       Text="{Binding Shell.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                       KeyDown="BingSearchBox_OnKeyDown" />
              <Path Stroke="#F2FFFFFF" StrokeThickness="5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,34,0" Width="50" Height="50"
                    Data="M17,17 A14,14 0 1 1 36,36M34,34 L47,47" />
            </Grid>
          </Border>
          <Button Canvas.Left="681" Canvas.Top="123" Width="83" Height="92" Opacity="0"
                  Command="{Binding SubmitSearchCommand}" />

          <!-- Trending searches (Xbox Bing hub behaviour) -->
          <ItemsControl Canvas.Left="180" Canvas.Top="232" Width="585"
                        ItemsSource="{Binding TrendingSearches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,12,8" Padding="14,6" Background="#C8000000"
                        BorderBrush="#6BFFFFFF" BorderThickness="1"
                        Foreground="#F2FFFFFF" FontSize="15" FontWeight="Light"
                        Command="{Binding DataContext.UseTrendingSearchCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" Content="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Virtual keyboard toggle hint -->
          <TextBlock Canvas.Left="180" Canvas.Top="332"
                     Foreground="#7FFFFFFF" FontSize="13" FontWeight="Light"
                     Text="Press Y for keyboard · A to search · B to back" />
        </Canvas>
      </Canvas>
    </Canvas>

    <!-- ===== RESULTS OVERLAY (Xbox Bing twist-control panes) ===== -->
    <Border Background="#E6000000" Visibility="{Binding IsResultsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid Margin="40,20,40,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: back + query echo + bing mark -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
          <TextBlock Text="bing" Foreground="#FFB900" FontSize="28" FontWeight="Light" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Shell.SearchQuery}" Foreground="#F2FFFFFF" FontSize="28"
                     FontWeight="Light" Margin="16,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ResultCountText}" Foreground="#BFFFFFFF" FontSize="14"
                     FontWeight="Light" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Category strip (Explore-pane echo) -->
        <ItemsControl Grid.Row="1" Name="CategoryStrip" Margin="0,0,0,14"
                      ItemsSource="{Binding Categories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="BingCat" Margin="0,0,18,0"
                           IsChecked="{Binding IsActive, Mode=TwoWay}"
                           Checked="Category_Checked"
                           Foreground="#F2FFFFFF" FontSize="18" FontWeight="Light"
                           Content="{Binding DisplayName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Twist pane: horizontal strip of result tiles -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding ActiveCategory.Results}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type bing:BingSearchResult}">
                <Button Width="190" Height="270" Margin="0,0,14,0"
                        Command="{Binding DataContext.OpenResultCommand,
                                  RelativeSource={RelativeSource AncestorType=Border}}"
                        CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="card" Background="#C8000000" BorderBrush="#6BFFFFFF"
                              BorderThickness="2" CornerRadius="2">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="*"/>
                          </Grid.RowDefinitions>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                 Grid.Row="0"/>
                          <Border Grid.Row="0" Background="#7F000000" VerticalAlignment="Bottom"
                                  Height="22">
                            <TextBlock Text="{Binding Source}" Foreground="#FFB900"
                                       FontSize="11" FontWeight="Light"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Row="1" Margin="8,6">
                            <TextBlock Text="{Binding Title}" Foreground="#F2FFFFFF"
                                       FontSize="14" FontWeight="Light" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#BFFFFFFF"
                                       FontSize="11" FontWeight="Light" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="card" Property="BorderBrush" Value="#107C10"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Footer hint bar -->
        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#7FFFFFFF" FontSize="13"
                   FontWeight="Light"
                   Text="A open · B back · LB/RB category · Y web search in browser"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
